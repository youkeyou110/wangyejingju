        "css-loader": "^6.10.0",
        "css-minimizer-webpack-plugin": "^6.0.0",
        "jest": "^29.7.0",
        "jest-environment-jsdom": "^29.7.0",
        "chrome-mock": "^0.0.9",
        "mini-css-extract-plugin": "^2.8.1",
        "postcss": "^8.4.35",
        "postcss-loader": "^8.1.1",
        "postcss-preset-env": "^9.4.0",
        "terser-webpack-plugin": "^5.3.10",
        "webpack": "^5.90.3",
