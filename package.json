        "copy-webpack-plugin": "^9.0.0",
        "css-loader": "^6.5.0",
        "css-minimizer-webpack-plugin": "^5.0.0",
        "eslint": "^8.42.0",
        "html-webpack-plugin": "^5.5.3",
        "jest": "^29.5.0",
        "mini-css-extract-plugin": "^2.7.6",
        "postcss": "^8.4.24",
        "postcss-loader": "^7.3.3",
        "prettier": "^2.8.8",
        "sharp": "^0.32.6",
        "terser-webpack-plugin": "^5.3.9",
